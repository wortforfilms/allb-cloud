{
  "name": "allb.xyz",
  "version": "1.0.0",
  "description": "MAATAA sovereign runtime and Siddham semiconductor ecosystem",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thelinep/allb.git"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "main": "index.js",
  "type": "module",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "install:all": "npm ci && npm ci --prefix apps/siddham-authority-desktop",
    "validate:structured": "node scripts/validate-structured-files.mjs",
    "build": "npm run contracts:check && cargo build --workspace --locked && npm run build:wasm && npm run desktop:check",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:wasm": "./scripts/build-edge.sh",
    "edge:dry-run": "wrangler deploy --dry-run --env staging",
    "edge:deploy:staging": "wrangler deploy --env staging",
    "desktop:install": "npm ci --prefix apps/siddham-authority-desktop",
    "desktop:check": "npm run check --prefix apps/siddham-authority-desktop",
    "desktop:test": "npm run rust:test --prefix apps/siddham-authority-desktop",
    "desktop:verify": "npm run verify --prefix apps/siddham-authority-desktop",
    "contracts:generate": "node scripts/generate-contracts.mjs",
    "contracts:check": "node scripts/generate-contracts.mjs --check",
    "contracts:python-check": "python3 -m unittest contracts/test_python_contracts.py",
    "preflight:disk": "node scripts/check-disk-space.mjs 6",
    "hygiene:check": "node scripts/repository-hygiene.mjs",
    "licenses:check": "node scripts/dependency-license-scan.mjs",
    "security:npm": "npm audit --package-lock-only --audit-level=high && npm --prefix apps/siddham-authority-desktop audit --package-lock-only --audit-level=high",
    "security:cargo": "cargo audit",
    "test:rtl": "make sim sim-top sim-panini rtl-check",
    "test:all": "cargo test --workspace --locked && npm test && npx tsc --noEmit && npm run contracts:python-check && npm run desktop:check && npm run test:rtl",
    "sbom:generate": "node scripts/generate-sbom.mjs",
    "artifacts:package": "node scripts/package-release.mjs",
    "verify": "npm run preflight:disk && npm run hygiene:check && npm run validate:structured && npm run contracts:check && npm run licenses:check && npm run security:npm && npm run security:cargo && cargo fmt --all -- --check && cargo clippy --workspace --all-targets --locked -- -D warnings && npm run build:wasm && npm run test:all",
    "ecosystem:verify": "npm run verify"
  },
  "dependencies": {
    "canonicalize": "^4.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "ajv": "^8.17.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.126.0",
    "yaml": "^2.8.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "workerd@1.20260825.1": true
  }
}
