{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Siddham OperationRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "principal",
    "action",
    "resource",
    "workspace",
    "assurance"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.(0|1)\\.[0-9]+$"
    },
    "requestId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "principal": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "action": {
      "enum": [
        "workspace:view",
        "runtime:execute",
        "dataset:read",
        "dataset:export",
        "model:promote",
        "agent:delegate",
        "policy:edit",
        "hardware:program",
        "release:approve",
        "evidence:export"
      ]
    },
    "resource": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "workspace": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "assurance": {
      "enum": [
        "AAL2",
        "AAL3",
        "mTLS",
        "Scoped capability"
      ]
    },
    "operation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "text"
          ],
          "properties": {
            "kind": {
              "const": "tokenizeBrahmi"
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "left",
            "right"
          ],
          "properties": {
            "kind": {
              "const": "evaluateSandhi"
            },
            "left": {
              "type": "string",
              "minLength": 1
            },
            "right": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "sutraId"
          ],
          "properties": {
            "kind": {
              "const": "lookupSutra"
            },
            "sutraId": {
              "type": "string",
              "pattern": "^\\\\d+\\\\.\\\\d+\\\\.\\\\d+$"
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "runtime:execute"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "operation": {}
        },
        "required": [
          "operation"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "not": {
              "const": "runtime:execute"
            }
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "not": {
          "required": [
            "operation"
          ]
        }
      }
    }
  ]
}
