{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "maataa-sovereign-worker",
  "main": "services/edge_worker/src/index.ts",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "brahmi.allb.xyz", "custom_domain": true }
  ],
  "build": {
    "command": "./scripts/build-edge.sh"
  },
  "vars": {
    "ENVIRONMENT": "production"
  },
  "dev": {
    "ip": "127.0.0.1",
    "port": 8787
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm"],
      "fallthrough": true
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "env": {
    "staging": {
      "name": "maataa-sovereign-worker-staging",
      "workers_dev": true,
      "preview_urls": true,
      "routes": [],
      "vars": {
        "ENVIRONMENT": "staging"
      },
      "observability": {
        "enabled": true,
        "logs": { "head_sampling_rate": 1 },
        "traces": { "enabled": true, "head_sampling_rate": 0.01 }
      }
    }
  }
}
